# ─────────────────────────────────────────────────────────────
#  NovaStream — Environment Variables
#  Copy this file as .env and fill in your API keys.
#  NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────────

# TMDB API Key  →  https://www.themoviedb.org/settings/api
TMDB_API_KEY=YOUR_TMDB_API_KEY_HERE

# OMDB API Key  →  https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=975e4605

# MySQL Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=novastream
